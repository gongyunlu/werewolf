{
  "name": "werewolf",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build:shared": "pnpm --filter @werewolf/shared build",
    "dev:shared": "pnpm --filter @werewolf/shared dev",
    "dev:api": "pnpm build:shared && pnpm --filter @werewolf/api dev",
    "dev:web": "pnpm build:shared && pnpm --filter @werewolf/web dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm build:shared && pnpm lint && pnpm typecheck",
    "test": "pnpm build:shared && pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mjs,cjs,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mjs,cjs,yml,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
