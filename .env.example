# 复制为 .env 后按需修改；.env 不入库。
NODE_ENV=development

# 后端服务监听端口
API_PORT=3201

# 对局库。开发口令是明文，只监听本机；本机 5432 上另有同名库，靠端口区分，别连错。
# 起库：docker compose up -d
DATABASE_URL=postgresql://werewolf:werewolf@127.0.0.1:5434/werewolf

# 队列与事件推送。同一个容器，与上面那条一起由 docker compose up -d 起来。
# 端口 6380 不用 6379：旧项目那两个 Redis 还占着 6378/6379。
REDIS_URL=redis://127.0.0.1:6380

# 管理写接口（开局、续跑、新建/改 agent 这些）的令牌，随请求的 x-admin-token 头带过来。
# 留空时写接口一律拒（不是放行），读接口不受影响。
ADMIN_TOKEN=

# agent 自带密钥的加密主密钥，64 位十六进制（32 字节）。换掉它，库里已有的密文就全解不开了。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AGENT_SECRET_KEY=

# 提示词平台。提示词以平台上的 production 版本为准，本地代码里那份只作兜底。
# 两个 key 有一个空着就整局走本地那份。
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 模型接入。MODEL_API_KEY 空着服务照样起得来，真开局时才拦。
# 密钥建议只写进 .env.local，那份不入库。
MODEL_API_KEY=
# 下面五项必填，缺一项服务起不来——它们决定「这一局是谁在答」，代码里不再兜一份。
# 换端点换型号就是改这一段，代码里没有任何一家的名字。
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
MODEL_DEFAULT_MODEL=deepseek-v4.1-flash
# 能力按「端点 + 型号」声明，JSON 数组。查不到就抛，不猜。
# toolChoice 默认 required；不支持强制工具的端点（如 ds 思考模式）声明为 auto。
# reasoningOff 是关掉思维链的请求体片段，原样并进请求。写 null 就是不写这一段：本例这个端点
# 默认开着思考，写 null 才是不关它；填 {"thinking":{"type":"disabled"}} 就把它关掉。
MODEL_CAPABILITIES=[{"baseUrl":"https://ark.cn-beijing.volces.com/api/plan/v3","model":"deepseek-v4.1-flash","reasoningOff":null}]
# 单次请求的硬上限。开思考后一问能跑到 5 分钟（实测最慢 313 秒），120 秒会让约 9% 的问
# 白撞一次重试、连撞三次整局退出（真局实测过一次）。
MODEL_REQUEST_TIMEOUT_MS=600000
MODEL_MAX_ATTEMPTS=3
