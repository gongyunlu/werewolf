// 对局库。加表加字段都经由 prisma migrate 出迁移，不手写 SQL。

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 一个参赛者的持久身份：叫什么、用哪个模型、从哪接入。坐哪一格由开局那份阵容定，不在这儿。
model Agent {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(64)

  // 默认型号。开局时把这一刻的值冻进阵容，改这里不影响已经在跑的对局。
  modelName        String  @map("model_name") @db.VarChar(64)
  // 接入端点。空着表示用环境变量那一套默认接入。
  baseUrl          String? @map("base_url") @db.VarChar(512)
  // 自带密钥的密文，只写不读，任何读接口都不返回它。
  apiKeyCiphertext String? @map("api_key_ciphertext") @db.Text
  // 密钥末四位，只为了在界面上认出配的是哪一把。
  apiKeyHint       String? @map("api_key_hint") @db.VarChar(4)

  // 分类标记，按它筛人用。
  tag      String? @db.VarChar(64)
  // 停用即软删：停用的不再能开局，历史对局里那份阵容快照照旧算数。
  isActive Boolean @default(true) @map("is_active")
  notes    String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memories              AgentMemory[]
  experiences           AgentExperience[]
  experienceGenerations ExperienceGeneration[]

  @@map("agents")
}

// 每份完成复盘中的玩家只提炼一次；输入、调用回执和零条结果也留档。
model ExperienceGeneration {
  id            String            @id @default(uuid()) @db.Uuid
  agentId       String            @map("agent_id") @db.Uuid
  gameId        String            @map("game_id") @db.VarChar(64)
  playerId      String            @map("player_id") @db.VarChar(64)
  reviewVersion String            @map("review_version") @db.VarChar(64)
  state         Json              @db.JsonB
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  agent         Agent             @relation(fields: [agentId], references: [id])
  experiences   AgentExperience[]

  @@unique([gameId, playerId, reviewVersion])
  @@map("experience_generations")
}

// 正文不可变；启停影响后续行动的检索，不改已保存的输入。
model AgentExperience {
  id           String               @id @db.Uuid
  agentId      String               @map("agent_id") @db.Uuid
  generationId String               @map("generation_id") @db.Uuid
  ordinal      Int                  @db.SmallInt
  boardId      String               @map("board_id") @db.VarChar(64)
  role         String               @db.VarChar(32)
  content      Json                 @db.JsonB
  enabled      Boolean              @default(true)
  embedding    Float[]              @default([])
  embeddingKey String?              @map("embedding_key") @db.VarChar(64)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  agent        Agent                @relation(fields: [agentId], references: [id])
  generation   ExperienceGeneration @relation(fields: [generationId], references: [id])

  @@unique([generationId, ordinal])
  @@index([agentId, boardId, enabled])
  @@index([boardId, role, enabled, embeddingKey])
  @@map("agent_experiences")
}

// 一个 agent 的人设与策略。整批替换，不单条增删；(agent, type, sort) 就是这条的身份。
model AgentMemory {
  agentId String @map("agent_id") @db.Uuid
  // persona 或 strategy，取值见 shared 的 AGENT_MEMORY_TYPES。
  type    String @db.VarChar(16)
  // 注入顺序，也是它在面板里的位置。
  sort    Int    @db.SmallInt

  title String @db.VarChar(64)
  body  String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, type, sort])
  @@map("agent_memories")
}

// 一局对局的档案：哪块板子、排到哪儿了、分出了什么胜负。
model Game {
  id         String  @id @db.VarChar(64)
  boardId    String  @map("board_id") @db.VarChar(64)
  // 开局那一刻的阵容：哪一格坐着谁、用哪个型号、从哪接入。冻在这儿，中途改 agent 不影响这一局。
  // 密钥不进这里：它按 agent 现读，换钥匙当场生效，端点对不上才拦。
  roster     Json?   @db.JsonB
  // 分出胜负时写这儿。有值就说明这局已经结束，不用再从阶段记录往下跑。
  winner     String? @db.VarChar(16)
  // 终局局面与胜方一起写入，阶段锚点仍只用于恢复。
  finalState Json?   @map("final_state") @db.JsonB
  // 队列上的位置：queued / running / finished / failed，取值见 shared 的 GAME_STATUSES。
  // 只在队列跑的局会有 failed；CLI 直接跑完的那些建档就是 finished。
  status     String  @default("queued") @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  steps       GameStep[]
  events      GameEvent[]
  actions     ActionRecord[]
  asked       AskedPrompt[]
  checkpoints GraphCheckpoint[]
  writes      GraphCheckpointWrite[]

  @@map("games")
}

// 阶段锚点：每进一格，把当下的完整局面和这一格的输入落下来。
// 恢复从最后一条接着跑，它前面的阶段不重放。
model GameStep {
  gameId          String @map("game_id") @db.VarChar(64)
  phaseInstanceId String @map("phase_instance_id") @db.VarChar(64)
  state           Json   @db.JsonB
  input           Json   @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, phaseInstanceId])
  @@map("game_steps")
}

// 过程台账：按 seq 读回来就是提示词里那份「已经发生的事」，各人只看得到受众含自己的那几条。
model GameEvent {
  gameId   String   @map("game_id") @db.VarChar(64)
  seq      Int      @db.SmallInt
  // 由提问键派生的幂等键：重放同一问不会写下第二条。
  eventKey String   @map("event_key") @db.VarChar(200)
  day      Int      @db.SmallInt
  text     String   @db.Text
  // 这条事实属于哪一类，取给谁看时按它分块；默认值只为改这一列之前的老行能补上。
  kind     String   @default("other") @db.VarChar(32)
  // 这条事实发生那一刻谁看得到，存玩家 id；写的人每次都会填，默认值只为老行能补上。
  audience String[] @default([])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, seq])
  @@unique([gameId, eventKey])
  @@map("game_events")
}

// 一次提问的提交记录。先立意图，答完再补结果。
// 恢复按主键取回：答完的直接复用，答一半的带着图里的检查点接着跑完。
model ActionRecord {
  actionKey           String @id @map("action_key") @db.VarChar(200)
  gameId              String @map("game_id") @db.VarChar(64)
  phaseInstanceId     String @map("phase_instance_id") @db.VarChar(64)
  actionType          String @map("action_type") @db.VarChar(32)
  actorId             String @map("actor_id") @db.VarChar(64)
  actionOrdinal       Int    @map("action_ordinal") @db.SmallInt
  // 立这一问时台账记到第几条。要取回的是这一问当初看到的那一份事实，而那是「位置」不是「键」：
  // 投票这种答完不留事实的提问，凭键找不回它的位置。
  ledgerSeq           Int    @default(0) @map("ledger_seq") @db.SmallInt
  // running 是「这次还没答完」，图里那几个检查点接着把它跑完；done 才是结果。
  status              String @default("running") @db.VarChar(16)
  outcome             Json?  @db.JsonB
  // 模型决策前固定本次检索；恢复时不读取后来变化的经验库。
  experienceRetrieval Json?  @map("experience_retrieval") @db.JsonB

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  doneAt    DateTime? @map("done_at") @db.Timestamptz

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, phaseInstanceId])
  @@map("action_records")
}

// 问出去的题面。提问那一刻先落一份：答到一半断了，那一问当初看到的是什么也还查得到。
// 格式重问使用新的 callId；传输重试写在 attempts 中。旧题面没有观测字段。
model AskedPrompt {
  id          Int     @id @default(autoincrement())
  gameId      String  @map("game_id") @db.VarChar(64)
  // 这一问属于哪次行动，按它跟行动记录对上；折摘要那一问不在行动里，为空。
  actionKey   String? @map("action_key") @db.VarChar(200)
  model       String  @db.VarChar(64)
  system      String  @db.Text
  prompt      String  @db.Text
  // 这一问要它走的工具定义；让它写一段话的那几问（发言）不走工具，为空。
  tool        Json?   @db.JsonB
  experiences Json?   @db.JsonB

  callId        String?   @unique @map("call_id") @db.Uuid
  summaryKey    String?   @map("summary_key") @db.VarChar(200)
  step          String?   @db.VarChar(32)
  executionId   String?   @map("execution_id") @db.Uuid
  taskId        String?   @map("task_id") @db.VarChar(120)
  checkpointId  String?   @map("checkpoint_id") @db.VarChar(120)
  formatAttempt Int?      @map("format_attempt") @db.SmallInt
  endpointKey   String?   @map("endpoint_key") @db.VarChar(64)
  status        String?   @db.VarChar(32)
  failureCode   String?   @map("failure_code") @db.VarChar(32)
  durationMs    Float?    @map("duration_ms")
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz
  traceId       String?   @map("trace_id") @db.VarChar(32)
  spanId        String?   @map("span_id") @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  game     Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  attempts ModelAttempt[]

  @@index([actionKey])
  @@index([gameId, id])
  @@map("asked_prompts")
}

// started 只证明本地准备了请求，崩溃后不能据此断定供应商是否收到。
model ModelAttempt {
  askedPromptId Int       @map("asked_prompt_id")
  attemptNo     Int       @map("attempt_no") @db.SmallInt
  status        String    @default("started") @db.VarChar(32)
  dispatched    Boolean?
  failureCode   String?   @map("failure_code") @db.VarChar(32)
  durationMs    Float?    @map("duration_ms")
  thinkingMs    Float?    @map("thinking_ms")
  httpStatus    Int?      @map("http_status") @db.SmallInt
  requestId     String?   @map("request_id") @db.Text
  usage         Json?     @db.JsonB
  usageComplete Boolean?  @map("usage_complete")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz
  traceId       String?   @map("trace_id") @db.VarChar(32)
  spanId        String?   @map("span_id") @db.VarChar(16)

  askedPrompt AskedPrompt @relation(fields: [askedPromptId], references: [id], onDelete: Cascade)

  @@id([askedPromptId, attemptNo])
  @@map("model_attempts")
}

// 图执行进度：每个 superstep 一份状态快照。
model GraphCheckpoint {
  gameId             String  @map("game_id") @db.VarChar(64)
  checkpointNs       String  @default("") @map("checkpoint_ns") @db.VarChar(200)
  checkpointId       String  @map("checkpoint_id") @db.VarChar(120)
  parentCheckpointId String? @map("parent_checkpoint_id") @db.VarChar(120)
  checkpoint         Json    @db.JsonB
  metadata           Json?   @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, checkpointNs, checkpointId])
  @@map("graph_checkpoints")
}

// 分支待写值。恢复时据此跳过已经跑完的那几个节点。
model GraphCheckpointWrite {
  gameId       String @map("game_id") @db.VarChar(64)
  checkpointNs String @default("") @map("checkpoint_ns") @db.VarChar(200)
  checkpointId String @map("checkpoint_id") @db.VarChar(120)
  taskId       String @map("task_id") @db.VarChar(120)
  idx          Int
  channel      String @db.VarChar(120)
  value        Json   @db.JsonB

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, checkpointNs, checkpointId, taskId, idx])
  @@map("graph_checkpoint_writes")
}
