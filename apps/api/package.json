{
  "name": "@werewolf/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "test": "jest",
    "game": "nest build && node dist/cli/run-game.js",
    "review:setup": "nest build && node dist/cli/setup-review.js",
    "experience:setup": "nest build && node dist/cli/setup-experience-prompts.js",
    "prompt:compare": "nest build && node dist/cli/compare-prompts.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langfuse/client": "5.11.1",
    "@langfuse/otel": "5.11.1",
    "@langfuse/tracing": "5.11.1",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@werewolf/shared": "workspace:*",
    "bullmq": "^6.3.8",
    "ioredis": "^6.0.0",
    "openai": "^7.19.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "jest": "^30.4.2",
    "oxlint": "^1.76.0",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/testing/env-setup.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "rootDir": "."
          }
        }
      ]
    },
    "testEnvironment": "node"
  }
}
